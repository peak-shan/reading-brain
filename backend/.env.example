# Database
DATABASE_URL=sqlite:///./reading_brain.db

# Volcano Ark API (火山方舟 — for AI summary & tagging)
VOLCANO_API_KEY=your_api_key_here
VOLCANO_MODEL_ID=your_model_id_here
